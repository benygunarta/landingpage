---
// ClientLogos.astro — Social Proof: deretan logo klien/partner
// Ganti src gambar di bawah dengan logo asli klien Anda dari:
// https://logoipsum.com/ (gratis, komersial) atau unduh logo klien sebenarnya.
const clients = [
  { name: "PT Teknologi Nusantara", src: "https://logoipsum.com/api/1/logo.svg" },
  { name: "CV Indo Solusi", src: "https://logoipsum.com/api/2/logo.svg" },
  { name: "Toko Makmur Abadi", src: "https://logoipsum.com/api/3/logo.svg" },
  { name: "Warung Digital", src: "https://logoipsum.com/api/4/logo.svg" },
  { name: "Bengkel Jaya", src: "https://logoipsum.com/api/5/logo.svg" },
  { name: "Catering Nusantara", src: "https://logoipsum.com/api/6/logo.svg" },
];
---
<section
  class="py-16 md:py-24 border-y border-slate-200 bg-slate-50"
  aria-label="Klien kami"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-3">
        Dipercaya Oleh Klien Kami
      </h2>
      <p class="text-slate-600 max-w-xl mx-auto">
        Bekerja sama dengan berbagai UMKM dan perusahaan dari skala kecil
        hingga menengah untuk mewujudkan digitalisasi bisnis.
      </p>
    </div>

    <div
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-8 md:gap-12 items-center justify-center"
    >
      {clients.map((client) => (
        <a
          href="#"
          class="flex items-center justify-center h-16 md:h-20 grayscale hover:grayscale-0 transition-all duration-300 opacity-70 hover:opacity-100"
          aria-label={client.name}
        >
          <img
            src={client.src}
            alt={client.name}
            class="h-auto max-h-full max-w-full object-contain drop-shadow-sm"
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Fallback jika SVG logo gagal load, tampilkan placeholder teks rapi */
  img[src*="logoipsum"] {
    background: #e2e8f0;
    border-radius: 0.5rem;
  }
</style>